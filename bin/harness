#!/bin/sh
# harness - install and maintain the agent-agnostic task harness in a repository.
#
#   harness install [--profile <name>] [--dry-run]   set it up in this repository
#   harness upgrade [--dry-run] [--force]            re-vendor what the harness owns
#   harness doctor                                   report what is missing or drifted
#   harness version
#
# The harness OWNS the mechanical files and replaces them on upgrade:
#   scripts/harness/verify   .githooks/pre-commit   .agents/skills/<vendored>
# The project OWNS everything that encodes a decision, and an upgrade never
# touches it:
#   scripts/harness/config.sh   docs/harness/*.md   openspec/config.yaml
#   AGENTS.md outside the harness markers
set -e

resolve() {
  p=$1
  while [ -L "$p" ]; do
    t=$(readlink "$p")
    case $t in /*) p=$t ;; *) p=$(dirname "$p")/$t ;; esac
  done
  printf '%s\n' "$p"
}
SELF=$(resolve "$0")
HOME_DIR=$(cd "$(dirname "$SELF")/.." && pwd)
VERSION=$(cat "$HOME_DIR/VERSION")

VENDORED_SKILLS="run-task harness-setup enrich-task adversarial-review commit update-docs code-auditing writing-skills using-git-worktrees architecture-guidelines"
BEGIN_MARK="<!-- harness:begin -->"
END_MARK="<!-- harness:end -->"

DRY=0
FORCE=0
PROFILE=""
FAILED=0

say()  { printf '%s\n' "$*"; }
step() { printf '  %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
bad()  { printf '  x %s\n' "$*" >&2; FAILED=1; }
die()  { printf 'harness: %s\n' "$*" >&2; exit 2; }

# --- helpers -----------------------------------------------------------------

require_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
  REPO=$(git rev-parse --show-toplevel)
  cd "$REPO"
}

detect_profile() {
  if [ -f pubspec.yaml ]; then echo flutter
  elif [ -f pnpm-workspace.yaml ]; then echo pnpm-turbo
  elif [ -f package.json ]; then echo node
  elif [ -f pyproject.toml ] || [ -f setup.py ]; then echo python
  else echo ""
  fi
}

same() { [ -f "$1" ] && [ -f "$2" ] && cmp -s "$1" "$2"; }

# install_owned <source> <target> [mode]
# The harness owns the target: it is replaced, unless it was edited locally and
# --force was not given.
install_owned() {
  src=$1; dst=$2; mode=${3:-644}
  if same "$src" "$dst"; then step "= $dst"; return 0; fi
  if [ -f "$dst" ] && [ "$MODE" = upgrade ] && [ "$FORCE" -eq 0 ] && [ -f "$REPO/scripts/harness/VERSION" ] && [ "$(cat "$REPO/scripts/harness/VERSION")" = "$VERSION" ]; then
    warn "$dst was modified locally and upstream has not changed - keeping it (use --force to replace)"
    return 0
  fi
  [ "$DRY" -eq 1 ] && { step "would write $dst"; return 0; }
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
  chmod "$mode" "$dst"
  step "+ $dst"
}

# install_kept <source> <target>
# The project owns the target: written once, never replaced.
install_kept() {
  src=$1; dst=$2
  if [ -e "$dst" ]; then step "= $dst (kept, yours)"; return 0; fi
  [ "$DRY" -eq 1 ] && { step "would create $dst"; return 0; }
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
  step "+ $dst (fill in its TODOs)"
}

ensure_line() {
  line=$1; file=$2
  [ -f "$file" ] && grep -qxF "$line" "$file" && return 0
  [ "$DRY" -eq 1 ] && { step "would add '$line' to $file"; return 0; }
  [ -f "$file" ] && [ -n "$(tail -c1 "$file")" ] && printf '\n' >> "$file"
  printf '%s\n' "$line" >> "$file"
  step "+ $file: $line"
}

inject_agents_block() {
  block=$HOME_DIR/templates/agents-section.md
  if [ ! -f AGENTS.md ]; then
    [ "$DRY" -eq 1 ] && { step "would create AGENTS.md"; return 0; }
    { printf '# Repository instructions for AI agents\n\n'
      printf '%s\n' "$BEGIN_MARK"; cat "$block"; printf '%s\n' "$END_MARK"; } > AGENTS.md
    step "+ AGENTS.md"
    return 0
  fi
  # If the file already documents the harness - under any heading - it is the
  # project's, and appending a generic block would only duplicate it.
  if ! grep -qF "$BEGIN_MARK" AGENTS.md && { grep -q '^## Harness' AGENTS.md || grep -q 'scripts/harness/verify' AGENTS.md; }; then
    step "= AGENTS.md (kept, yours: it already documents the harness)"
    return 0
  fi
  tmp=$(mktemp)
  if grep -qF "$BEGIN_MARK" AGENTS.md; then
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" -v f="$block" '
      $0==b { print; while ((getline l < f) > 0) print l; skip=1; next }
      $0==e { skip=0 }
      !skip { print }
    ' AGENTS.md > "$tmp"
  else
    { cat AGENTS.md
      printf '\n%s\n' "$BEGIN_MARK"; cat "$block"; printf '%s\n' "$END_MARK"; } > "$tmp"
  fi
  if cmp -s "$tmp" AGENTS.md; then rm -f "$tmp"; step "= AGENTS.md"; return 0; fi
  [ "$DRY" -eq 1 ] && { rm -f "$tmp"; step "would update the harness block in AGENTS.md"; return 0; }
  mv "$tmp" AGENTS.md
  step "~ AGENTS.md (harness block)"
}

vendor_skills() {
  for s in $VENDORED_SKILLS; do
    src=$HOME_DIR/skills/$s
    [ -d "$src" ] || continue
    dst=.agents/skills/$s
    # A symlink is replaced even when it resolves to identical content: one that
    # escapes the repository does not survive a clone on another machine.
    if [ ! -L "$dst" ] && [ -d "$dst" ] && diff -rq "$src" "$dst" >/dev/null 2>&1; then :
    else
      [ "$DRY" -eq 1 ] && { step "would vendor $dst"; continue; }
      mkdir -p .agents/skills
      rm -rf "$dst"
      cp -R "$src" "$dst"
      step "+ $dst"
    fi
    link=.claude/skills/$s
    if [ ! -e "$link" ] && [ ! -L "$link" ]; then
      [ "$DRY" -eq 1 ] && { step "would link $link"; continue; }
      mkdir -p .claude/skills
      ln -sfn "../../.agents/skills/$s" "$link"
      step "+ $link -> ../../.agents/skills/$s"
    fi
  done
}

# --- commands ----------------------------------------------------------------

cmd_install() {
  require_repo
  [ -n "$PROFILE" ] || PROFILE=$(detect_profile)
  [ -n "$PROFILE" ] || die "could not detect the stack; pass --profile (available: $(ls "$HOME_DIR/profiles" | sed 's/\.sh$//' | paste -sd', ' -))"
  [ -f "$HOME_DIR/profiles/$PROFILE.sh" ] || die "unknown profile '$PROFILE'"

  say "harness $VERSION -> $REPO (profile: $PROFILE)${DRY:+}"
  [ "$DRY" -eq 1 ] && say "  (dry run: nothing is written)"

  install_owned "$HOME_DIR/core/verify" scripts/harness/verify 755
  install_kept  "$HOME_DIR/profiles/$PROFILE.sh" scripts/harness/config.sh
  install_owned "$HOME_DIR/core/pre-commit" .githooks/pre-commit 755
  install_owned "$HOME_DIR/VERSION" scripts/harness/VERSION 644

  vendor_skills

  install_kept "$HOME_DIR/templates/mandatory-steps.md" docs/harness/mandatory-steps.md
  install_kept "$HOME_DIR/templates/architecture-rules.md" docs/harness/architecture-rules.md
  install_kept "$HOME_DIR/templates/openspec-config.yaml" openspec/config.yaml

  inject_agents_block

  if [ ! -e CLAUDE.md ]; then
    [ "$DRY" -eq 1 ] && step "would link CLAUDE.md -> AGENTS.md" || { ln -sfn AGENTS.md CLAUDE.md; step "+ CLAUDE.md -> AGENTS.md"; }
  else
    step "= CLAUDE.md (kept, yours)"
  fi

  ensure_line '.harness/' .gitignore
  ensure_line '.tgrep/' .gitignore
  ensure_line '.codegraph/' .gitignore

  if [ "$DRY" -eq 0 ]; then
    git config core.hooksPath .githooks
    step "+ git config core.hooksPath .githooks"
  fi

  say ""
  say "Next: an agent can finish this with you. Point it at"
  say "  .agents/skills/harness-setup/SKILL.md"
  say "(in Claude Code: /harness-setup). It detects the stack, asks you only what it"
  say "cannot read, and fills in config.sh, mandatory-steps.md and architecture-rules.md."
  say ""
  say "By hand instead:"
  say "  1. scripts/harness/config.sh - make the gates and test commands real."
  say "  2. docs/harness/mandatory-steps.md and architecture-rules.md - replace every TODO."
  say "  3. harness doctor - it will tell you what is still missing."
}

cmd_upgrade() {
  MODE=upgrade
  require_repo
  [ -f scripts/harness/config.sh ] || die "no harness here yet - run 'harness install'"
  was=$( [ -f scripts/harness/VERSION ] && cat scripts/harness/VERSION || echo unknown )
  say "harness $was -> $VERSION in $REPO"
  install_owned "$HOME_DIR/core/verify" scripts/harness/verify 755
  install_owned "$HOME_DIR/core/pre-commit" .githooks/pre-commit 755
  vendor_skills
  install_owned "$HOME_DIR/VERSION" scripts/harness/VERSION 644
  say ""
  say "config.sh, docs/harness/*.md, openspec/config.yaml and AGENTS.md were not touched."
}

check() { if [ "$1" = 0 ]; then step "ok  $2"; else bad "$2 - $3"; fi; }

cmd_doctor() {
  require_repo
  say "harness doctor - $REPO"
  say ""
  say "repository"

  [ -f scripts/harness/verify ] && st=0 || st=1
  check $st "scripts/harness/verify present" "run 'harness install'"

  if [ -f scripts/harness/verify ]; then
    same "$HOME_DIR/core/verify" scripts/harness/verify && st=0 || st=1
    if [ $st -ne 0 ]; then
      v=$( [ -f scripts/harness/VERSION ] && cat scripts/harness/VERSION || echo unknown )
      if [ "$v" != "$VERSION" ]; then
        warn "verify is from harness $v, upstream is $VERSION - run 'harness upgrade'"
      else
        warn "verify differs from upstream at the same version - it was edited locally"
      fi
    else
      step "ok  verify matches harness $VERSION"
    fi
  fi

  if [ -f scripts/harness/config.sh ]; then
    missing=""
    for fn in harness_gates harness_test_selected harness_test_all; do
      grep -q "^ *$fn()" scripts/harness/config.sh || missing="$missing $fn"
    done
    grep -q '^HARNESS_CODE_PATHS=' scripts/harness/config.sh || missing="$missing HARNESS_CODE_PATHS"
    [ -z "$missing" ] && step "ok  config.sh defines the contract" || bad "config.sh is missing:$missing" "see profiles/ in the harness repo"
    if grep -q 'TODO' scripts/harness/config.sh; then warn "config.sh still contains TODO"; fi
  else
    bad "scripts/harness/config.sh missing" "run 'harness install'"
  fi

  [ -x .githooks/pre-commit ] && st=0 || st=1
  check $st ".githooks/pre-commit present and executable" "run 'harness install'"

  [ "$(git config --get core.hooksPath 2>/dev/null)" = ".githooks" ] && st=0 || st=1
  check $st "core.hooksPath points at .githooks" "run: git config core.hooksPath .githooks"

  if [ -L CLAUDE.md ]; then
    [ "$(readlink CLAUDE.md)" = "AGENTS.md" ] && step "ok  CLAUDE.md -> AGENTS.md" || bad "CLAUDE.md points elsewhere" "Claude Code only autoloads CLAUDE.md"
  elif [ -f CLAUDE.md ]; then
    warn "CLAUDE.md is a real file, not a symlink to AGENTS.md - the two can drift"
  else
    bad "CLAUDE.md missing" "Claude Code only autoloads CLAUDE.md: ln -s AGENTS.md CLAUDE.md"
  fi

  if [ -f AGENTS.md ]; then
    # The section is the project's to edit, so check that it still points at the
    # two things that matter rather than demanding the generated block verbatim.
    grep -q 'run-task' AGENTS.md && step "ok  AGENTS.md points at run-task" || bad "AGENTS.md never mentions run-task" "an agent has no entry point to the loop"
    grep -q 'scripts/harness/verify' AGENTS.md && step "ok  AGENTS.md points at the gate" || bad "AGENTS.md never mentions scripts/harness/verify" "an agent will not know how to verify"
  else
    bad "AGENTS.md missing" "run 'harness install'"
  fi

  for f in docs/harness/mandatory-steps.md docs/harness/architecture-rules.md; do
    if [ -f "$f" ]; then
      if grep -q 'TODO(harness)' "$f"; then warn "$f still has TODO(harness) - a template, not a decision yet: follow .agents/skills/harness-setup/SKILL.md"; else step "ok  $f"; fi
    else
      bad "$f missing" "run 'harness install'"
    fi
  done

  n=0
  for s in $VENDORED_SKILLS; do [ -d ".agents/skills/$s" ] && n=$((n+1)); done
  [ "$n" -eq "$(printf '%s\n' $VENDORED_SKILLS | wc -l | tr -d ' ')" ] && step "ok  $n vendored skills" || warn "$n vendored skills present, expected $(printf '%s\n' $VENDORED_SKILLS | wc -l | tr -d ' ')"

  esc=$(find .agents/skills .claude/skills -maxdepth 2 -type l 2>/dev/null | while read -r l; do
    t=$(readlink "$l")
    if [ "${t#/}" != "$t" ]; then echo "$l -> $t"; fi
  done)
  if [ -z "$esc" ]; then
    step "ok  no skill symlink escapes the repository"
  else
    # No pipeline here: a `while read` in a pipe runs in a subshell, and the
    # failure it records would be lost along with it.
    oldifs=$IFS
    IFS='
'
    for e in $esc; do bad "absolute symlink: $e" "it will not resolve on another machine"; done
    IFS=$oldifs
  fi

  say ""
  say "what this repository already enforces (wire it into harness_gates, do not duplicate it)"
  found=0
  for probe in .dependency-cruiser.cjs .dependency-cruiser.js .eslintrc .eslintrc.json eslint.config.js .flake8 ruff.toml analysis_options.yaml; do
    [ -e "$probe" ] && { step "found $probe"; found=1; }
  done
  for pat in 'architecture' 'boundar'; do
    hits=$(find . -path ./node_modules -prune -o -name "*$pat*" -path "*test*" -print 2>/dev/null | head -4)
    [ -n "$hits" ] && { printf '%s\n' "$hits" | sed 's/^/  found /'; found=1; }
  done
  [ "$found" -eq 0 ] && step "nothing detected - if nothing enforces your layers, every rule depends on the agent behaving"

  for cfg in eslint.config.js .eslintrc .eslintrc.json .prettierignore analysis_options.yaml ruff.toml pyproject.toml; do
    if [ -f "$cfg" ] && ! grep -q '\.agents' "$cfg"; then
      warn "$cfg does not exclude .agents - vendored skills ship third-party files (a script, a dotfile) that a linter or formatter will flag as yours"
    fi
  done

  say ""
  say "machine (user-level, not per project)"
  for tool in openspec tgrep rtk codegraph; do
    command -v "$tool" >/dev/null 2>&1 && step "ok  $tool" || warn "$tool not on PATH"
  done
  if [ -f "$HOME/.config/openspec/config.json" ]; then
    grep -q '"workflows"' "$HOME/.config/openspec/config.json" && step "ok  openspec workflow set configured (global)" || warn "openspec has no explicit workflow set - it is global config, not per project"
  else
    warn "no ~/.config/openspec/config.json - the workflow set is global config, not per project"
  fi

  say ""
  [ "$FAILED" -eq 0 ] && say "doctor: no blocking problems" || say "doctor: problems above need fixing"
  return $FAILED
}

MODE=install
cmd=${1:-help}
[ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
  case $1 in
    --profile) PROFILE=$2; shift 2 ;;
    --profile=*) PROFILE=${1#*=}; shift ;;
    --dry-run) DRY=1; shift ;;
    --force) FORCE=1; shift ;;
    *) die "unknown option: $1" ;;
  esac
done

case $cmd in
  install) cmd_install ;;
  upgrade) cmd_upgrade ;;
  doctor)  cmd_doctor ;;
  version) say "harness $VERSION" ;;
  help|--help|-h) sed -n '2,14p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try: install, upgrade, doctor, version)" ;;
esac
